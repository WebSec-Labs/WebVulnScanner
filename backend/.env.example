# WebVulnScanner Backend Environment Configuration
# Copy this file to .env for local development overrides.
# DO NOT commit actual secrets or credentials to version control.

ENVIRONMENT=development
PROJECT_NAME=WebVulnScanner
VERSION=0.1.0
API_V1_STR=/api/v1

# Server Settings
HOST=127.0.0.1
PORT=8000

# CORS Origins (comma-separated for multiple origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
